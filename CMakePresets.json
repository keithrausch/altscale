{
    "version": 6,

    "configurePresets": [
        {
            "name": "debug_native",
            "displayName": "Debug (Native)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug_native",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release_native",
            "displayName": "Release (Native)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release_native",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "debug-arm64",
            "displayName": "Debug ARM64",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/arm64/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_SYSTEM_NAME": "Linux",
                "CMAKE_SYSTEM_PROCESSOR": "aarch64",
                "CMAKE_C_COMPILER": "aarch64-linux-gnu-gcc",
                "CMAKE_CXX_COMPILER": "aarch64-linux-gnu-g++"
            }
        },
        {
            "name": "release-arm64",
            "displayName": "Release ARM64",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/arm64/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_SYSTEM_NAME": "Linux",
                "CMAKE_SYSTEM_PROCESSOR": "aarch64",
                "CMAKE_C_COMPILER": "aarch64-linux-gnu-gcc",
                "CMAKE_CXX_COMPILER": "aarch64-linux-gnu-g++"
            }
        },
        {
            "name": "debug-amd64",
            "displayName": "Debug AMD64",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/amd64/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_SYSTEM_NAME": "Linux",
                "CMAKE_SYSTEM_PROCESSOR": "x86_64",
                "CMAKE_C_COMPILER": "x86_64-linux-gnu-gcc",
                "CMAKE_CXX_COMPILER": "x86_64-linux-gnu-g++"
            }
        },
        {
            "name": "release-amd64",
            "displayName": "Release AMD64",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/amd64/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_SYSTEM_NAME": "Linux",
                "CMAKE_SYSTEM_PROCESSOR": "x86_64",
                "CMAKE_C_COMPILER": "x86_64-linux-gnu-gcc",
                "CMAKE_CXX_COMPILER": "x86_64-linux-gnu-g++"
            }
        }
    ],

    "buildPresets": [
        {
            "name": "debug_native",
            "configurePreset": "debug_native"
        },
        {
            "name": "release_native",
            "configurePreset": "release_native"
        },
        {
            "name": "debug-arm64",
            "configurePreset": "debug-arm64"
        },
        {
            "name": "release-arm64",
            "configurePreset": "release-arm64"
        },
        {
            "name": "debug-amd64",
            "configurePreset": "debug-amd64"
        },
        {
            "name": "release-amd64",
            "configurePreset": "release-amd64"
        }
    ]
}
